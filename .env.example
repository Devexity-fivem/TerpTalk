# Database — PostgreSQL required (SQLite no longer supported).
# Local dev: point to a local Postgres or a Neon free-tier dev branch.
# Production (Vercel): paste your Neon pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Production only (Vercel): unpooled/direct Neon URL used by scripts/prebuild-migrate.mjs for
# `prisma migrate deploy` (PgBouncer pooling breaks Prisma's advisory lock). Falls back to
# POSTGRES_URL_NON_POOLING → DIRECT_URL → DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# NextAuth
# NEXTAUTH_URL: your deployment origin (e.g. https://terptalk.vercel.app). Vercel sets NEXTAUTH_URL automatically only for preview deployments — set it explicitly in production.
NEXTAUTH_URL="http://localhost:3000"
# Optional public site origin used in metadata/sitemaps. Defaults to NEXTAUTH_URL when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Generate with: openssl rand -hex 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# IMPORTANT: use a DIFFERENT secret for production than development.
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"

# Privacy: salt for hashing IP addresses in security logs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT="REPLACE_WITH_GENERATED_SALT"

# Seed staff accounts (optional — used by `npm run seed` only)
# ADMIN_USERNAME="ttadmin"
# ADMIN_PASSWORD="generate-a-strong-password"
# MOD_USERNAME="ttmoderator"
# MOD_PASSWORD="generate-a-strong-password"

# No email is collected or sent; account recovery uses a phrase (no SMTP_* needed).

# Vercel Blob (optional — required for image uploads; sharp normalizes and
# strips metadata server-side)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Realtime chat (optional - falls back to polling if unset) ---
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=
# NEXT_PUBLIC_PUSHER_KEY=  # same value as PUSHER_KEY
# NEXT_PUBLIC_PUSHER_CLUSTER=

# --- Registration anti-bot (REQUIRED for production) ---
# Cloudflare Turnstile replaces the built-in math captcha when both are set.
# Set BOTH or neither — the client renders the widget from the site key,
# the server verifies with the secret.
# Without TURNSTILE_SECRET_KEY, registration REFUSES to run when
# NODE_ENV=production (the math captcha is dev/test-only — trivially
# scriptable and intentionally never a production gate).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cron auth — REQUIRED in production. /api/cron/* refuses to run without
# it (the vercel-cron user-agent fallback is forgeable). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and add the same value to vercel.json's cron Authorization header env.
# CRON_SECRET=

# --- Optional runtime ---
# TRUST_CLOUDFLARE_HEADERS=1   # trust CF-Connecting-IP for rate-limit/IP hashing when behind Cloudflare
# TRUST_PROXY_HEADERS=1        # trust x-real-ip / X-Forwarded-For — ONLY when behind a
#                              # single proxy that sets/strips them (e.g. nginx). Vercel
#                              # deployments don't need this (x-vercel-forwarded-for is
#                              # platform-set). Off-platform without a trusted proxy these
#                              # headers are client-spoofable, so they're ignored and
#                              # requests fall back to the shared "unknown" bucket.
# NEXT_PUBLIC_VISIBLE_STATUS=false  # set to "false" + redeploy to hide all tier chips (see src/components/tier-chip.tsx)

# --- Test / verification only (never set in Vercel) ---
# ALLOW_PRODUCTION_DB_TESTS=1  # overrides scripts/db-guard.mjs — never set casually
# VERIFY_URL=http://localhost:3000   # base URL for *-verify.mjs scripts
# MASTER_ONLY="id1,id2"        # run only listed master-tests suites (others reported as SKIP)
# MASTER_DEV_COMMAND="…"       # override the dev-server spawn command used by master-tests
# MASTER_BASE_URL=http://localhost:3000  # base URL master-tests runs against
# MIGRATE_ON_BUILD=1   # force the prebuild-migrate gate outside VERCEL_ENV=production
