// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User and Authentication
model User {
  id            String    @id @default(cuid())
  name          String?
  // No email field — registration is username-only by design (data minimization)
  image         String?
  password      String?
  role          String    @default("MEMBER") // MEMBER, VERIFIED_MEMBER, SUPPORT, MODERATOR, ADMINISTRATOR
  status        String    @default("OFFLINE") // ONLINE, AWAY, OFFLINE
  lastSeenAt    DateTime?
  ageVerified   Boolean   @default(false)
  banned        Boolean   @default(false)
  bannedReason  String?
  suspendedUntil DateTime?
  recoveryPhraseHash String?
  sessionVersion  Int       @default(0)
  onboardingCompletedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  posts         Post[]
  threadCreator Thread[] @relation("ThreadAuthor")
  diaryCreator  GrowDiary[]
  diaryUpdates  DiaryUpdate[]
  setupCreator  GrowSetup[]
  setupComments SetupComment[]
  contestEntries ContestEntry[]
  contestVotes   ContestVote[]
  diaryContestEntries DiaryContestEntry[]
  diaryContestVotes   DiaryContestVote[]
  guides         Guide[]
  affiliateClicks AffiliateClick[]
  chatMessages  ChatMessage[]
  sentMessages  DirectMessage[]      @relation("SentMessages")
  receivedMessages DirectMessage[]   @relation("ReceivedMessages")
  notifications Notification[]
  triggeredNotifications Notification[] @relation("NotificationActor")
  reactions     Reaction[]
  followers     Follow[]             @relation("Following")
  following     Follow[]             @relation("Follower")
  badges        UserBadge[]
  reputation    ReputationEvent[]
  strainsCreated Strain[]
  strainPhotos  StrainPhoto[]
  reports       Report[]
  moderatorActions ModerationAction[]
  staffApplications StaffApplication[]
  reviewedApplications StaffApplication[] @relation("Reviewer")
  categoryFollows CategoryFollow[]
  threadFollows  ThreadFollow[]
  savedSearches  SavedSearch[]
  guideEdits    GuideEdit[]
  pollVotes     PollVote[]
  blockedUsers  Block[]              @relation("Blocker")
  blockedBy     Block[]              @relation("Blocked")

  @@index([role])
  @@index([status])
  @@index([lastSeenAt])
}

// Staff Applications

model StaffApplication {
  id          String   @id @default(cuid())
  userId      String
  role        String   // SUPPORT | MODERATOR
  why         String
  experience  String
  about       String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote  String?
  reviewedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applicant   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer    User?    @relation("Reviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@index([role, status])
}

// User Profile

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String   @unique
  bio            String?
  location       String?
  website        String?
  avatarUrl      String?
  growExperience String?
  favoriteStrain String?
  joinDate     DateTime @default(now())
  reputation   Int      @default(0)
  growSpace    String?
  referredById String?
  referredBy   Profile?  @relation("ProfileReferrals", fields: [referredById], references: [id])
  referrals    Profile[] @relation("ProfileReferrals")
  businessName String?
  businessType String?
  businessUrl  String?
  youtubeChannelUrl String?
  notifyOnReply        Boolean  @default(true)
  notifyOnMention      Boolean  @default(true)
  notifyOnCategoryFollow Boolean @default(true)
  notifyOnMessage      Boolean  @default(true)
  notifyOnComment      Boolean  @default(true)
  notifyOnFollow       Boolean  @default(true)
  notifyOnReaction     Boolean  @default(true)
  notifyOnMilestone    Boolean  @default(true)
  emailDigestFrequency String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([reputation])
  @@index([referredById])
}

// Forum Categories
model Category {
  id          String   @id @default(cuid())
  name        String
  description String
  slug        String   @unique
  icon        String?
  color       String?
  order       Int      @default(0)
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  threads     Thread[]
  followers   CategoryFollow[]

  @@index([slug])
  @@index([order])
}

model CategoryFollow {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
  @@index([userId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String
  filters   String   @default("{}")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Forum Threads
model Thread {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  categoryId String
  authorId   String
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  deleted    Boolean  @default(false)
  views      Int      @default(0)
  replyCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Bumped only when a new reply lands — updatedAt is polluted by view
  // increments, so it can't drive unread indicators.
  lastActivityAt DateTime @default(now())
  acceptedAnswerId String? @unique

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author     User     @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  posts      Post[]
  bookmarks  Bookmark[]
  images     PostImage[]
  tags       ThreadTag[]
  poll       Poll?
  acceptedAnswer Post?  @relation("ThreadAcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)
  followers  ThreadFollow[]

  @@index([categoryId])
  @@index([authorId])
  @@index([slug])
  @@index([replyCount])
  @@index([createdAt])
}

// Followed threads — drives reply notifications (throttled via
// lastNotifiedAt) and unread indicators (lastSeenAt vs lastActivityAt).
model ThreadFollow {
  id             String    @id @default(cuid())
  userId         String
  threadId       String
  lastSeenAt     DateTime?
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([threadId])
  @@index([userId])
}

// Forum Posts
model Post {
  id        String   @id @default(cuid())
  content   String
  threadId  String
  authorId  String
  edited    Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  images    PostImage[]
  acceptedAnswerFor Thread? @relation("ThreadAcceptedAnswer")

  @@index([threadId])
  @@index([authorId])
  @@index([createdAt])
  @@index([threadId, createdAt])
}

// Images attached to a thread's opening post or to a reply. Exactly one of
// threadId/postId is set, mirroring how Reaction targets posts or diaries.
model PostImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  order     Int      @default(0)
  threadId  String?
  postId    String?
  createdAt DateTime @default(now())

  thread    Thread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([postId])
}

// Reactions
model Reaction {
  id        String   @id @default(cuid())
  type      String   // LIKE, LOVE, LAUGH, THINKING, FIRE, THUMBS_UP, THUMBS_DOWN
  userId    String
  postId    String?
  diaryId   String?
  createdAt DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  diary     GrowDiary?   @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, diaryId])
  @@index([postId])
  @@index([diaryId])
}

// Bookmarks
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
  @@index([threadId])
}

// Follow System
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Follower", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// Block System
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Grow Diaries
model GrowDiary {
  id            String   @id @default(cuid())
  title         String
  description   String
  strain        String?
  genetics      String?
  growType      String   // INDOOR, OUTDOOR, GREENHOUSE
  startDate     DateTime
  medium        String?
  containerSize String?
  lighting      String?
  nutrients     String?
  equipment     String?
  spaceDimensions String?
  authorId      String
  featured      Boolean  @default(false)
  deleted       Boolean  @default(false)
  stage         String   @default("GERMINATION") // GERMINATION, SEEDLING, VEGETATIVE, FLOWER, HARVEST, DRYING, CURING, COMPLETED
  harvested     Boolean  @default(false)
  harvestedAt   DateTime?
  yieldAmount   Float?
  yieldUnit     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  updates       DiaryUpdate[]
  reactions     Reaction[]
  followers     DiaryFollow[]
  diaryContestEntries DiaryContestEntry[]

  @@index([authorId])
  @@index([strain])
  @@index([featured])
  @@index([createdAt])
  @@index([harvested, harvestedAt])
}

model DiaryUpdate {
  id           String   @id @default(cuid())
  title        String
  content      String
  dayNumber    Int?
  weekNumber   Int?
  stage        String   // GERMINATION, SEEDLING, VEGETATIVE, FLOWER, HARVEST, DRYING, CURING, COMPLETED
  temperature  Float?
  humidity     Float?
  vpd          Float?
  ph           Float?
  ec           Float?
  feeding      String?
  training     String?
  diaryId      String
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diary        GrowDiary   @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  author       User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images       DiaryImage[]

  @@index([diaryId])
  @@index([diaryId, createdAt])
  @@index([authorId])
  @@index([createdAt])
}

model DiaryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  updateId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  update    DiaryUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@index([updateId])
}

model DiaryFollow {
  id        String   @id @default(cuid())
  userId    String
  diaryId   String
  createdAt DateTime @default(now())

  diary     GrowDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@unique([userId, diaryId])
  @@index([userId])
  @@index([diaryId])
}

// Grow Setups
model GrowSetup {
  id          String   @id @default(cuid())
  title       String
  description String
  space       String?
  tent        String?
  lighting    String?
  ventilation String?
  fans        String?
  containers  String?
  medium      String?
  nutrients   String?
  controllers String?
  equipment   String?
  strain      String?
  authorId    String
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images      SetupImage[]
  comments    SetupComment[]

  @@index([authorId])
  @@index([createdAt])
  @@index([strain])
}

model SetupImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  setupId   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  setup     GrowSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@index([setupId])
}

model SetupComment {
  id        String   @id @default(cuid())
  content   String
  setupId   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setup     GrowSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([setupId])
  @@index([authorId])
}

// Chat System
model ChatRoom {
  id              String        @id @default(cuid())
  name            String
  description     String?
  slug            String        @unique
  order           Int           @default(0)
  isPrivate       Boolean       @default(false)
  slowModeSeconds Int           @default(0)
  locked          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  messages    ChatMessage[]

  @@index([slug])
  @@index([order])
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  roomId    String
  authorId  String
  replyToId String?
  edited    Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room      ChatRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo   ChatMessage? @relation("ChatMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatMessageReply")

  @@index([roomId])
  @@index([authorId])
  @@index([createdAt])
  @@index([roomId, createdAt])
  @@index([replyToId])
}

// Direct Messages
model DirectMessage {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  receiverId String
  read      Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([senderId, receiverId])
}

// Notifications
model Notification {
  id        String   @id @default(cuid())
  type      String   // REACTION, COMMENT, REPLY, MENTION, FOLLOW, DIARY_UPDATE, DIRECT_MESSAGE, THREAD_ACTIVITY, MODERATOR_ANNOUNCEMENT, BADGE, REPUTATION, REFERRAL, ACCEPTED_ANSWER
  userId    String
  actorId   String?
  groupKey  String?
  metadata  Json?
  title     String
  content   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([actorId])
  @@index([userId, groupKey])
}

// Strain Database
model Strain {
  id          String   @id @default(cuid())
  name        String   @unique
  genetics    String?
  breeder     String?
  type        String?
  description String?
  growingInfo String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  photos      StrainPhoto[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// Community photos of a strain — plant shots and harvested flower
model StrainPhoto {
  id        String   @id @default(cuid())
  kind      String   // PLANT | FLOWER
  imageUrl  String   // data URI (client-resized)
  caption   String?
  strainId  String
  userId    String
  createdAt DateTime @default(now())

  strain    Strain   @relation(fields: [strainId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([strainId])
  @@index([userId])
}

// Badges System
model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String?
  color       String?
  requirement String
  createdAt   DateTime @default(now())

  userBadges  UserBadge[]

  @@index([name])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

// Reputation System
// Reputation 2.0 ledger — append-only. Profile.reputation is a cached
// balance; the invariant is reputation == SUM(amount WHERE reversedAt IS NULL).
// `key` is an idempotency token so retries/deferred writes can never
// double-award (same convention as BotEvent.key). Reversals are signed
// counter-entries linked by reversalOfId — history is never deleted.
model ReputationEvent {
  id           String    @id @default(cuid())
  type         String    // REP_POINTS keys | REVERSAL | STAFF_ADJUSTMENT | LEGACY_MIGRATION
  userId       String    // recipient
  amount       Int       // signed: +award, -reversal/deduction
  reason       String    // owner-facing display string; staff details stay out of public labels
  key          String?   @unique // idempotency token, e.g. "post:<id>", "like:<reactor>:post:<id>"
  sourceType   String?             // THREAD | POST | DIARY | SETUP | STRAIN | STRAIN_PHOTO | CONTEST
  sourceId     String?             // id of the causing entity — enables bulk reversal on deletion
  actorId      String?             // who triggered it (liker, acceptor, staff); null = system/self
  reversedAt   DateTime?           // set when a counter-entry cancels this row
  reversalOfId String?             // set on counter-entries, points at the original row
  createdAt    DateTime  @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
  @@index([actorId])
  @@index([reversalOfId])
  @@index([type, createdAt])
  @@index([createdAt])
}

// Reports and Moderation
model Report {
  id           String    @id @default(cuid())
  type         String    // THREAD, POST, CHAT_MESSAGE, PROFILE, DIARY, SETUP
  reason       String
  description  String?
  reporterId   String
  reportedId   String
  targetId     String?   // ID of the reported content (thread/post/message id)
  status       String    @default("PENDING") // PENDING, REVIEWING, ESCALATED, RESOLVED, DISMISSED
  priority     String    @default("NORMAL")  // LOW, NORMAL, HIGH, URGENT — derived from reason, staff-overridable
  resolution   String?   // Moderator note on resolution
  assignedToId String?   // bare string — survives staff account deletion
  resolvedById String?   // bare string
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reporter    User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([reportedId])
  @@index([assignedToId, status])
}

// Automated trust & safety signals — persisted so staff can triage, assign,
// and resolve them like reports. `key` makes detector re-scans idempotent.
model AbuseFlag {
  id             String   @id @default(cuid())
  signal         String   // REP_VELOCITY | REP_RECIPROCAL_PAIR | REP_NEW_ACCOUNT_LIKES
  userId         String   // subject — bare string, same convention as SecurityEvent.userId
  counterpartyId String?  // second user for pair signals
  key            String   @unique // dedupe token, e.g. "repvel:<userId>:<yyyy-mm-dd>"
  evidence       Json?    // snapshot of detector output at flag time
  status         String   @default("PENDING") // PENDING, REVIEWING, ESCALATED, RESOLVED, DISMISSED
  priority       String   @default("NORMAL")  // LOW, NORMAL, HIGH, URGENT
  resolution     String?
  assignedToId   String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([assignedToId, status])
}

model ModerationAction {
  id          String   @id @default(cuid())
  type        String   // WARNING, TEMPORARY_BAN, PERMANENT_BAN, CONTENT_DELETION, CONTENT_EDIT
  reason      String
  targetUserId String
  moderatorId String
  duration    Int?     // in days for temporary bans
  reportId    String?  // links REPORT_* / assignment actions back to the case
  flagId      String?  // links FLAG_* actions back to the abuse flag
  createdAt   DateTime @default(now())

  moderator   User                 @relation(fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@index([moderatorId])
  @@index([createdAt])
  @@index([reportId])
  @@index([flagId])
}

// Security Infrastructure
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String   // LOGIN_SUCCESS, LOGIN_FAILURE, REGISTRATION, PASSWORD_CHANGE, ACCOUNT_DELETED, RATE_LIMIT_EXCEEDED, SUSPICIOUS_ACTIVITY, AUTHORIZATION_FAILURE
  userId    String?
  ipHash    String?  // SHA-256 hash of IP (never store raw IP for privacy)
  userAgent String?
  metadata  String?  // JSON string with non-sensitive context
  createdAt DateTime @default(now())

  @@index([type])
  @@index([userId])
  @@index([createdAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model Captcha {
  id        String   @id @default(cuid())
  answer    String
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([expiresAt])
}

// Weekly contest � Budshot of the Week
model ContestEntry {
  id        String   @id @default(cuid())
  week      String   // e.g. "2026-W37"
  imageUrl  String
  caption   String?
  userId    String
  createdAt DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     ContestVote[]

  @@unique([userId, week])
  @@index([week])
}

model ContestVote {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  week      String   @default("") // denormalized from entry.week — powers one-vote-per-week
  createdAt DateTime @default(now())

  entry     ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@unique([userId, week])
  @@index([entryId])
}

// Monthly contest — Diary of the Month (parallel to Budshot models;
// kept separate so the weekly photo contest is unaffected)
model DiaryContestEntry {
  id        String   @id @default(cuid())
  month     String   // e.g. "2026-05"
  diaryId   String
  userId    String
  createdAt DateTime @default(now())

  diary     GrowDiary          @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     DiaryContestVote[]

  @@unique([userId, month])
  @@unique([diaryId, month])
  @@index([month])
}

model DiaryContestVote {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  month     String   @default("") // denormalized from entry.month — powers one-vote-per-month
  createdAt DateTime @default(now())

  entry     DiaryContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@unique([userId, month])
  @@index([entryId])
}

// Staff-authored grow guides
model Guide {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  topic     String   // e.g. BASICS, NUTRIENTS, HARVEST, PESTS
  published Boolean  @default(true)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  edits     GuideEdit[]

  @@index([slug])
  @@index([published])
}

model GuideEdit {
  id        String   @id @default(cuid())
  guideId   String
  editorId  String
  content   String
  createdAt DateTime @default(now())

  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  editor    User     @relation(fields: [editorId], references: [id], onDelete: Cascade)

  @@index([guideId])
  @@index([editorId])
}

// --- Affiliate System ---
model AffiliatePartner {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  websiteUrl   String
  affiliateUrl String   // default partner-level affiliate URL
  promoCode    String?
  description  String
  promoText    String?  // current promotion text
  promoStart   DateTime?
  promoEnd     DateTime?
  active       Boolean  @default(true)
  featured     Boolean  @default(false)
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products     AffiliateProduct[]
  clicks       AffiliateClick[]

  @@index([active])
  @@index([featured])
}

model AffiliateProduct {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  partnerId      String
  productUrl     String?  // plain product page
  affiliateUrl   String?  // falls back to partner.affiliateUrl
  imageUrl       String?
  description    String
  category       String
  pros           String?  // one per line
  cons           String?  // one per line
  recommendedFor String?
  price          String?  // free text, e.g. ".99"
  promoCode      String?  // falls back to partner.promoCode
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner        AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  clicks         AffiliateClick[]

  @@index([partnerId])
  @@index([category])
  @@index([active])
}

model AffiliateClick {
  id        String   @id @default(cuid())
  partnerId String
  productId String?
  page      String?  // referring path e.g. /deals or /forum/thread/x
  userId    String?  // only if logged in; no PII beyond account id
  createdAt DateTime @default(now())

  partner   AffiliatePartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product   AffiliateProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([productId])
  @@index([createdAt])
}

// Simple key/value site config (affiliate disclosure, etc.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Polls (one per thread) ─────────────────────────────────────────

model Poll {
  id        String   @id @default(cuid())
  threadId  String   @unique
  question  String
  multiple  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread  Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([threadId])
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  text   String
  order  Int    @default(0)

  poll  Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@index([pollId, order])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
  @@index([userId])
}

// ─── Forum Tags ─────────────────────────────────────────────────────

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threads ThreadTag[]

  @@index([slug])
}

model ThreadTag {
  threadId String
  tagId    String

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([threadId])
  @@index([tagId])
}

// ─── TerpBot telemetry ──────────────────────────────────────────────
// One row per real bot action. Chat messages hard-delete after 3 days, so
// durable bot stats and achievements need their own store. Never stores
// message contents, IPs, or request bodies — `key` is a unique idempotency
// token so retries/duplicate invocations can never double-count, and
// `userId` is a bare string so a member deleting their account never
// orphans or blocks a write.
model BotEvent {
  id        String   @id @default(cuid())
  type      String   // COMMAND_SLASH | COMMAND_MENTION | MENTION_HELP | MENTION_FALLBACK | MENTION_REFUSAL | ANNOUNCEMENT | DAY_ACTIVE
  key       String   @unique
  userId    String?  // requesting member; null for announcements/system events
  command   String?  // canonical command name, or announcement kind (welcome/digest/contest)
  entities  Int      @default(0) // internal thread/guide/strain/diary links surfaced in the response
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId])
}
