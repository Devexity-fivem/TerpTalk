// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User and Authentication
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("MEMBER") // MEMBER, VERIFIED_MEMBER, MODERATOR, ADMINISTRATOR
  status        String    @default("OFFLINE") // ONLINE, AWAY, OFFLINE
  lastSeenAt    DateTime?
  ageVerified   Boolean   @default(false)
  banned        Boolean   @default(false)
  bannedReason  String?
  recoveryPhraseHash String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  posts         Post[]
  threadCreator Thread[] @relation("ThreadAuthor")
  diaryCreator  GrowDiary[]
  diaryUpdates  DiaryUpdate[]
  setupCreator  GrowSetup[]
  setupComments SetupComment[]
  contestEntries ContestEntry[]
  contestVotes   ContestVote[]
  guides         Guide[]
  affiliateClicks AffiliateClick[]
  chatMessages  ChatMessage[]
  sentMessages  DirectMessage[]      @relation("SentMessages")
  receivedMessages DirectMessage[]   @relation("ReceivedMessages")
  notifications Notification[]
  reactions     Reaction[]
  followers     Follow[]             @relation("Following")
  following     Follow[]             @relation("Follower")
  badges        UserBadge[]
  reputation    ReputationEvent[]
  strainsCreated Strain[]
  strainPhotos  StrainPhoto[]
  reports       Report[]
  moderatorActions ModerationAction[]
  blockedUsers  Block[]              @relation("Blocker")
  blockedBy     Block[]              @relation("Blocked")

  @@index([role])
  @@index([status])
}

// User Profile
model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String   @unique
  bio            String?
  location       String?
  website        String?
  avatarUrl      String?
  growExperience String?
  favoriteStrain String?
  joinDate     DateTime @default(now())
  reputation   Int      @default(0)
  growSpace    String?
  referredById String?
  referredBy   Profile?  @relation("ProfileReferrals", fields: [referredById], references: [id])
  referrals    Profile[] @relation("ProfileReferrals")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([referredById])
}

// Forum Categories
model Category {
  id          String   @id @default(cuid())
  name        String
  description String
  slug        String   @unique
  icon        String?
  color       String?
  order       Int      @default(0)
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  threads     Thread[]

  @@index([slug])
  @@index([order])
}

// Forum Threads
model Thread {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  categoryId String
  authorId   String
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  deleted    Boolean  @default(false)
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author     User     @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  posts      Post[]
  bookmarks  Bookmark[]

  @@index([categoryId])
  @@index([authorId])
  @@index([slug])
  @@index([createdAt])
}

// Forum Posts
model Post {
  id        String   @id @default(cuid())
  content   String
  threadId  String
  authorId  String
  edited    Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions Reaction[]

  @@index([threadId])
  @@index([authorId])
  @@index([createdAt])
  @@index([threadId, createdAt])
}

// Reactions
model Reaction {
  id        String   @id @default(cuid())
  type      String   // LIKE, LOVE, LAUGH, THINKING, FIRE, THUMBS_UP, THUMBS_DOWN
  userId    String
  postId    String?
  diaryId   String?
  createdAt DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  diary     GrowDiary?   @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, diaryId])
  @@index([postId])
  @@index([diaryId])
}

// Bookmarks
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
  @@index([threadId])
}

// Follow System
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Follower", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// Block System
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Grow Diaries
model GrowDiary {
  id            String   @id @default(cuid())
  title         String
  description   String
  strain        String?
  genetics      String?
  growType      String   // INDOOR, OUTDOOR, GREENHOUSE
  startDate     DateTime
  medium        String?
  containerSize String?
  lighting      String?
  nutrients     String?
  equipment     String?
  spaceDimensions String?
  authorId      String
  featured      Boolean  @default(false)
  deleted       Boolean  @default(false)
  stage         String   @default("GERMINATION") // GERMINATION, SEEDLING, VEGETATIVE, FLOWER, HARVEST, DRYING, CURING, COMPLETED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  updates       DiaryUpdate[]
  reactions     Reaction[]
  followers     DiaryFollow[]

  @@index([authorId])
  @@index([strain])
  @@index([featured])
  @@index([createdAt])
}

model DiaryUpdate {
  id           String   @id @default(cuid())
  title        String
  content      String
  dayNumber    Int?
  weekNumber   Int?
  stage        String   // GERMINATION, SEEDLING, VEGETATIVE, FLOWER, HARVEST, DRYING, CURING, COMPLETED
  temperature  Float?
  humidity     Float?
  vpd          Float?
  ph           Float?
  ec           Float?
  feeding      String?
  training     String?
  diaryId      String
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diary        GrowDiary   @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  author       User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images       DiaryImage[]

  @@index([diaryId])
  @@index([authorId])
  @@index([createdAt])
}

model DiaryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  updateId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  update    DiaryUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@index([updateId])
}

model DiaryFollow {
  id        String   @id @default(cuid())
  userId    String
  diaryId   String
  createdAt DateTime @default(now())

  diary     GrowDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@unique([userId, diaryId])
  @@index([userId])
  @@index([diaryId])
}

// Grow Setups
model GrowSetup {
  id          String   @id @default(cuid())
  title       String
  description String
  space       String?
  tent        String?
  lighting    String?
  ventilation String?
  fans        String?
  containers  String?
  medium      String?
  nutrients   String?
  controllers String?
  equipment   String?
  authorId    String
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images      SetupImage[]
  comments    SetupComment[]

  @@index([authorId])
  @@index([createdAt])
}

model SetupImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  setupId   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  setup     GrowSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@index([setupId])
}

model SetupComment {
  id        String   @id @default(cuid())
  content   String
  setupId   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setup     GrowSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([setupId])
  @@index([authorId])
}

// Chat System
model ChatRoom {
  id          String        @id @default(cuid())
  name        String
  description String?
  slug        String        @unique
  order       Int           @default(0)
  isPrivate   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  messages    ChatMessage[]

  @@index([slug])
  @@index([order])
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  roomId    String
  authorId  String
  edited    Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([authorId])
  @@index([createdAt])
  @@index([roomId, createdAt])
}

// Direct Messages
model DirectMessage {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  receiverId String
  read      Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([senderId, receiverId])
}

// Notifications
model Notification {
  id        String   @id @default(cuid())
  type      String   // LIKE, COMMENT, REPLY, MENTION, FOLLOW, DIARY_UPDATE, DIRECT_MESSAGE, THREAD_ACTIVITY, MODERATOR_ANNOUNCEMENT
  userId    String
  title     String
  content   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read])
}

// Strain Database
model Strain {
  id          String   @id @default(cuid())
  name        String   @unique
  genetics    String?
  breeder     String?
  type        String?
  description String?
  growingInfo String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  photos      StrainPhoto[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// Community photos of a strain — plant shots and harvested flower
model StrainPhoto {
  id        String   @id @default(cuid())
  kind      String   // PLANT | FLOWER
  imageUrl  String   // data URI (client-resized)
  caption   String?
  strainId  String
  userId    String
  createdAt DateTime @default(now())

  strain    Strain   @relation(fields: [strainId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([strainId])
  @@index([userId])
}

// Badges System
model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String?
  color       String?
  requirement String
  createdAt   DateTime @default(now())

  userBadges  UserBadge[]

  @@index([name])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

// Reputation System
model ReputationEvent {
  id        String   @id @default(cuid())
  type      String   // POST_CREATED, COMMENT_CREATED, DIARY_CREATED, DIARY_UPDATE, HELPFUL_ANSWER, COMMUNITY_CONTRIBUTION
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Reports and Moderation
model Report {
  id          String   @id @default(cuid())
  type        String   // POST, COMMENT, CHAT_MESSAGE, PROFILE, DIRECT_MESSAGE, DIARY, SETUP
  reason      String
  description String?
  reporterId  String
  reportedId  String
  targetId    String?  // ID of the reported content (thread/post/message id)
  status      String   @default("PENDING") // PENDING, REVIEWING, RESOLVED, DISMISSED
  resolution  String?  // Moderator note on resolution
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter    User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
}

model ModerationAction {
  id          String   @id @default(cuid())
  type        String   // WARNING, TEMPORARY_BAN, PERMANENT_BAN, CONTENT_DELETION, CONTENT_EDIT
  reason      String
  targetUserId String
  moderatorId String
  duration    Int?     // in days for temporary bans
  createdAt   DateTime @default(now())

  moderator   User                 @relation(fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@index([moderatorId])
  @@index([createdAt])
}

// Security Infrastructure
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String   // LOGIN_SUCCESS, LOGIN_FAILURE, REGISTRATION, PASSWORD_CHANGE, ACCOUNT_DELETED, RATE_LIMIT_EXCEEDED, SUSPICIOUS_ACTIVITY, AUTHORIZATION_FAILURE
  userId    String?
  ipHash    String?  // SHA-256 hash of IP (never store raw IP for privacy)
  userAgent String?
  metadata  String?  // JSON string with non-sensitive context
  createdAt DateTime @default(now())

  @@index([type])
  @@index([userId])
  @@index([createdAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model Captcha {
  id        String   @id @default(cuid())
  answer    String
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([expiresAt])
}

// Weekly contest � Budshot of the Week
model ContestEntry {
  id        String   @id @default(cuid())
  week      String   // e.g. "2026-W37"
  imageUrl  String
  caption   String?
  userId    String
  createdAt DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     ContestVote[]

  @@unique([userId, week])
  @@index([week])
}

model ContestVote {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  createdAt DateTime @default(now())

  entry     ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([entryId])
}

// Staff-authored grow guides
model Guide {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  topic     String   // e.g. BASICS, NUTRIENTS, HARVEST, PESTS
  published Boolean  @default(true)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([published])
}

// --- Affiliate System ---
model AffiliatePartner {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  websiteUrl   String
  affiliateUrl String   // default partner-level affiliate URL
  promoCode    String?
  description  String
  promoText    String?  // current promotion text
  promoStart   DateTime?
  promoEnd     DateTime?
  active       Boolean  @default(true)
  featured     Boolean  @default(false)
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products     AffiliateProduct[]
  clicks       AffiliateClick[]

  @@index([active])
  @@index([featured])
}

model AffiliateProduct {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  partnerId      String
  productUrl     String?  // plain product page
  affiliateUrl   String?  // falls back to partner.affiliateUrl
  imageUrl       String?
  description    String
  category       String
  pros           String?  // one per line
  cons           String?  // one per line
  recommendedFor String?
  price          String?  // free text, e.g. ".99"
  promoCode      String?  // falls back to partner.promoCode
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner        AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  clicks         AffiliateClick[]

  @@index([partnerId])
  @@index([category])
  @@index([active])
}

model AffiliateClick {
  id        String   @id @default(cuid())
  partnerId String
  productId String?
  page      String?  // referring path e.g. /deals or /forum/thread/x
  userId    String?  // only if logged in; no PII beyond account id
  createdAt DateTime @default(now())

  partner   AffiliatePartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product   AffiliateProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([productId])
  @@index([createdAt])
}

// Simple key/value site config (affiliate disclosure, etc.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
